[Unit]
Description=Agenda finalização exata da telemetria em sete dias
# TelemetryWindowStartUTC=@WINDOW_START_UTC@
# TelemetryFinalizeAtUTC=@FINALIZE_AT_UTC@

[Timer]
OnCalendar=@FINALIZE_AT_UTC@
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=tool-telemetry-finalize.service

[Install]
WantedBy=timers.target
